# Copy to .env and fill in. Never commit .env (it is git-ignored).

# From https://app.gnani.ai/voice after registering for the challenge.
GNANI_API_KEY=

# Challenge stack defaults (override only to experiment).
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5
# Blank = best voice for REMO_LANG (Nalini for hi-IN, Zahira for mr-IN).
GNANI_TTS_VOICE=
REMO_LANG=hi-IN

# Optional: raises GitHub API rate limits for the change watcher.
GITHUB_TOKEN=

# Optional: natural answers composed by Gemini over retrieved notes.
# Without a key, Remo answers extractively (fully offline apart from Gnani speech).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
