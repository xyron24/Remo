# Copy to .env and fill in. Never commit .env (it is git-ignored).

# From https://app.gnani.ai/voice after registering for the challenge.
GNANI_API_KEY=

# Challenge stack defaults (override only to experiment).
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5
# Blank = best voice for REMO_LANG (Nalini for hi-IN, Zahira for mr-IN).
GNANI_TTS_VOICE=
REMO_LANG=hi-IN

# Optional: raises GitHub API rate limits for the change watcher.
GITHUB_TOKEN=

# Optional: natural answers composed by Gemini over retrieved notes.
# Without a key, Remo answers extractively (fully offline apart from Gnani speech).
GEMINI_API_KEY=
# Tried in order when one is quota-exhausted or down.
GEMINI_MODELS=gemini-2.5-flash,gemini-3-flash-preview

# Sign-in: Google OAuth (from Google Cloud Console, Credentials, OAuth client).
# Register these redirect URIs there: http://127.0.0.1:8000/api/auth/google/callback
# plus https://YOUR-HOST/api/auth/google/callback for every deployment.
# Without these, only email+password sign-in works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL of a deployment (for the OAuth callback). Blank = auto-detect (local use).
REMO_PUBLIC_URL=
# Set to 1 on https deployments so the session cookie is Secure.
REMO_COOKIE_SECURE=
